RESEND_API_KEY=test-key
RESEND_URL=http://127.0.0.1:8799/emails
MAIL_FROM=One Style <no-reply@example.test>
SITE_URL=http://127.0.0.1:8788
ADMIN_EMAIL=owner@example.test
ORDER_EMAIL=orders@example.test
