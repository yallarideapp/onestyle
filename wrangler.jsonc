{
  // One Style — one Worker serves the site (dist/) and answers /api/*.
  // The Worker's name in the Cloudflare dashboard must match "name".
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onestyle",
  "main": "worker/src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*", "/", "/ar", "/ar/*", "/shop", "/devices/*", "/guide", "/service", "/compare", "/account", "/admin", "/admin/*",
      "/mac", "/iphone", "/ipad", "/audio", "/watch", "/accessories", "/used-like-new", "/custom-*", "/sitemap.xml", "/robots.txt"
    ]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "onestyle-db", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [
    { "binding": "PHOTOS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "observability": { "enabled": true },
  // Keep the variables set in the dashboard (SITE_URL, ADMIN_EMAIL, …) when a push deploys.
  "keep_vars": true
  // Secrets (set in the dashboard or with `npx wrangler secret put NAME`, never here):
  //   SETUP_CODE      first admin sign-in code (long and random)
  //   RESEND_API_KEY  optional: order emails and password-reset links through Resend
  // Variables (dashboard: Settings > Variables and Secrets > Add > Text):
  //   ORDER_EMAIL     optional: where order emails go
  //   MAIL_FROM       sender on the shop's verified Resend domain, e.g. One Style <no-reply@domain>
  //   SITE_URL        the site's public https address, for reset links (no trailing slash)
  //   ADMIN_EMAIL     optional: the only address an admin reset link is sent to
}
